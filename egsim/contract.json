 "schemas": {
  "Allocation": {
   "properties": {
    "allocatedKwh": {
     "$ref": "#/components/schemas/QuantityKwhNonNegative"
    },
    "deliveryDate": {
     "$ref": "#/components/schemas/DeliveryDate"
    },
    "energyCommunityId": {
     "$ref": "#/components/schemas/EnergyCommunityId"
    },
    "intervalStart": {
     "$ref": "#/components/schemas/IntervalStartOrNull"
    },
    "positionId": {
     "$ref": "#/components/schemas/PositionId"
    },
    "reason": {
     "$ref": "#/components/schemas/AllocationReason"
    },
    "requestedKwh": {
     "$ref": "#/components/schemas/QuantityKwh"
    },
    "type": {
     "$ref": "#/components/schemas/PositionType"
    }
   },
   "required": [
    "deliveryDate",
    "intervalStart",
    "positionId",
    "energyCommunityId",
    "type",
    "requestedKwh",
    "allocatedKwh",
    "reason"
   ],
   "type": "object"
  },
  "AllocationReason": {
   "description": "FULLY_ALLOCATED: volle Menge. PARTIALLY_ALLOCATED: Angebot wegen Überangebot nur teilweise gekauft. NOT_ALLOCATED: Angebot wegen Überangebot gar nicht gekauft (nach der Zuteilungsregel der Plattform). NOT_NEEDED: es gab keinen Bedarf. RESERVE_SHORTAGE: Bedarf gekürzt, weil die Reserve nicht reichte.",
   "enum": [
    "FULLY_ALLOCATED",
    "PARTIALLY_ALLOCATED",
    "NOT_ALLOCATED",
    "NOT_NEEDED",
    "RESERVE_SHORTAGE"
   ],
   "type": "string"
  },
  "AmountEur": {
   "type": "number",
   "x-maxDecimals": 2
  },
  "CommunityCode": {
   "description": "Plattformübergreifende Kennung der EG (Vorschlag). Unveränderlich, pro Plattform eindeutig.",
   "examples": [
    "eg-mmm"
   ],
   "maxLength": 40,
   "minLength": 3,
   "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
   "type": "string"
  },
  "Credentials": {
   "properties": {
    "apiKey": {
     "type": "string"
    },
    "password": {
     "type": "string"
    }
   },
   "required": [
    "apiKey",
    "password"
   ],
   "type": "object"
  },
  "DeliveryDate": {
   "examples": [
    "2026-11-20"
   ],
   "format": "date",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
   "type": "string"
  },
  "EnergyCommunity": {
   "properties": {
    "communityCode": {
     "$ref": "#/components/schemas/CommunityCode"
    },
    "createdAt": {
     "$ref": "#/components/schemas/Timestamp"
    },
    "description": {
     "type": "string"
    },
    "email": {
     "format": "email",
     "maxLength": 254,
     "type": "string"
    },
    "id": {
     "$ref": "#/components/schemas/EnergyCommunityId"
    },
    "name": {
     "type": "string"
    },
    "status": {
     "$ref": "#/components/schemas/EnergyCommunityStatus"
    },
    "updatedAt": {
     "$ref": "#/components/schemas/Timestamp"
    }
   },
   "required": [
    "id",
    "email",
    "communityCode",
    "name",
    "status",
    "createdAt",
    "updatedAt"
   ],
   "type": "object"
  },
  "EnergyCommunityId": {
   "examples": [
    "3f6c1c8e-5b1f-4c37-a8b1-1c6d9b9d2a10"
   ],
   "format": "uuid",
   "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
   "type": "string"
  },
  "EnergyCommunityRegistration": {
   "additionalProperties": false,
   "properties": {
    "communityCode": {
     "$ref": "#/components/schemas/CommunityCode"
    },
    "description": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "email": {
     "format": "email",
     "maxLength": 254,
     "type": "string"
    },
    "name": {
     "maxLength": 120,
     "minLength": 1,
     "pattern": "\\S",
     "type": "string"
    }
   },
   "required": [
    "email",
    "communityCode",
    "name"
   ],
   "type": "object"
  },
  "EnergyCommunityStatus": {
   "enum": [
    "PENDING",
    "ACTIVE",
    "SUSPENDED"
   ],
   "type": "string"
  },
  "EnergyCommunityStatusUpdate": {
   "additionalProperties": false,
   "properties": {
    "status": {
     "$ref": "#/components/schemas/EnergyCommunityStatus"
    }
   },
   "required": [
    "status"
   ],
   "type": "object"
  },
  "EnergyCommunityUpdate": {
   "additionalProperties": false,
   "description": "Profil bearbeiten. status und communityCode sind hier nicht erlaubt (400 VALIDATION_FAILED).",
   "minProperties": 1,
   "properties": {
    "description": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "name": {
     "maxLength": 120,
     "minLength": 1,
     "pattern": "\\S",
     "type": "string"
    }
   },
   "type": "object"
  },
  "Error": {
   "properties": {
    "code": {
     "$ref": "#/components/schemas/ErrorCode"
    },
    "details": {
     "items": {
      "properties": {
       "code": {
        "$ref": "#/components/schemas/ErrorCode"
       },
       "field": {
        "examples": [
         "/quantityKwh"
        ],
        "type": "string"
       },
       "message": {
        "type": "string"
       }
      },
      "required": [
       "field",
       "message"
      ],
      "type": "object"
     },
     "type": "array"
    },
    "message": {
     "type": "string"
    },
    "requestId": {
     "description": "Gleicher Wert wie der Antwort-Header X-Request-Id.",
     "type": "string"
    }
   },
   "required": [
    "code",
    "message",
    "requestId"
   ],
   "type": "object"
  },
  "ErrorCode": {
   "enum": [
    "VALIDATION_FAILED",
    "INVALID_ID",
    "INVALID_DELIVERY_DATE",
    "INVALID_INTERVAL",
    "INVALID_POSITION_TYPE",
    "INVALID_QUANTITY",
    "INVALID_PRICE",
    "UNAUTHORIZED",
    "INVALID_CREDENTIALS",
    "FORBIDDEN",
    "ENERGY_COMMUNITY_NOT_ACTIVE",
    "ENERGY_COMMUNITY_NOT_FOUND",
    "POSITION_NOT_FOUND",
    "MARKET_NOT_FOUND",
    "EMAIL_ALREADY_REGISTERED",
    "COMMUNITY_CODE_ALREADY_REGISTERED",
    "ENERGY_COMMUNITY_IN_USE",
    "INVALID_STATUS_TRANSITION",
    "POSITION_ALREADY_EXISTS",
    "POSITION_NOT_MODIFIABLE",
    "IDEMPOTENCY_KEY_REUSED",
    "MARKET_CLOSED",
    "MARKET_NOT_SETTLED",
    "RATE_LIMITED",
    "INTERNAL_ERROR"
   ],
   "type": "string"
  },
  "Health": {
   "properties": {
    "checks": {
     "additionalProperties": {
      "enum": [
       "UP",
       "DOWN"
      ],
      "type": "string"
     },
     "examples": [
      {
       "database": "UP"
      }
     ],
     "type": "object"
    },
    "status": {
     "enum": [
      "UP",
      "DOWN"
     ],
     "type": "string"
    }
   },
   "required": [
    "status"
   ],
   "type": "object"
  },
  "IntervalResult": {
   "properties": {
    "intervalStart": {
     "$ref": "#/components/schemas/IntervalStart"
    },
    "reserve": {
     "$ref": "#/components/schemas/Reserve"
    },
    "totalDemandKwh": {
     "$ref": "#/components/schemas/QuantityKwhTotal"
    },
    "totalOfferedKwh": {
     "$ref": "#/components/schemas/QuantityKwhTotal"
    },
    "totalPurchasedKwh": {
     "$ref": "#/components/schemas/QuantityKwhTotal"
    },
    "totalSoldKwh": {
     "$ref": "#/components/schemas/QuantityKwhTotal"
    }
   },
   "required": [
    "intervalStart",
    "totalOfferedKwh",
    "totalDemandKwh",
    "totalPurchasedKwh",
    "totalSoldKwh",
    "reserve"
   ],
   "type": "object"
  },
  "IntervalStart": {
   "description": "Beginn des 15-Minuten-Intervalls in UTC (nur bei QUARTER_HOUR).",
   "examples": [
    "2026-11-20T11:15:00Z"
   ],
   "format": "date-time",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:(00|15|30|45):00(\\.0+)?Z$",
   "type": "string"
  },
  "IntervalStartOrNull": {
   "description": "Beginn des Lieferintervalls; null im Tagesmarkt (DAY).",
   "oneOf": [
    {
     "$ref": "#/components/schemas/IntervalStart"
    },
    {
     "type": "null"
    }
   ]
  },
  "LoginRequest": {
   "additionalProperties": false,
   "properties": {
    "email": {
     "format": "email",
     "maxLength": 254,
     "type": "string"
    },
    "password": {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "email",
    "password"
   ],
   "type": "object"
